{# Expects `tags` = collections.tagList entries ({ tag, count }). #}
<ul class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
  {% for entry in tags %}
    <li>
      <a href="{{ prefix }}/tags/{{ entry.tag | slugify }}/"
         style="font-size: {{ entry.weight }}rem"
         class="text-ef-grey2 transition-colors hover:text-ef-green"
         title="{{ entry.count }} {{ "yazı" if lang == "tr" else ("post" if entry.count == 1 else "posts") }}">#{{ entry.tag }}</a>
    </li>
  {% else %}
    <li class="text-sm text-ef-grey1">{{ 'Henüz etiket yok.' if lang == 'tr' else 'No tags yet.' }}</li>
  {% endfor %}
</ul>
